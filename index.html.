<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Zina Accessoires</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #111;
      color: white;
    }

    /* HEADER */
    header {
      background: #111;
      padding: 20px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #333;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      color: white;
      font-size: 25px;
      font-weight: bold;
    }

    .logo span {
      display: block;
      font-size: 11px;
      letter-spacing: 4px;
      color: #ffd84d;
      margin-top: 4px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 25px;
      font-weight: bold;
    }

    nav a:hover {
      color: #ffd84d;
    }

    /* HERO */
    .hero {
      min-height: 550px;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 60px 20px;
      background:
        linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.8)),
        url("https://images.unsplash.com/photo-1523170335258-f5ed11844a49?auto=format&fit=crop&w=1600&q=80")
        center/cover;
    }

    .hero h1 {
      font-size: 55px;
      margin-bottom: 15px;
    }

    .hero h1 span {
      color: #ffd84d;
    }

    .hero p {
      font-size: 20px;
      color: #ddd;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      background: #ffd84d;
      color: #111;
      padding: 15px 30px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      transition: .3s;
    }

    .btn:hover {
      transform: translateY(-3px);
      background: white;
    }

    /* SECTION */
    section {
      padding: 70px 7%;
    }

    .title {
      text-align: center;
      margin-bottom: 45px;
    }

    .title h2 {
      font-size: 35px;
      margin-bottom: 10px;
    }

    .title p {
      color: #aaa;
    }

    /* PRODUCTS */
    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .product {
      background: #1c1c1c;
      border-radius: 15px;
      overflow: hidden;
      border: 1px solid #333;
      transition: .3s;
    }

    .product:hover {
      transform: translateY(-7px);
      border-color: #ffd84d;
    }

    .product img {
      width: 100%;
      height: 280px;
      object-fit: cover;
      display: block;
    }

    .product-info {
      padding: 20px;
    }

    .product-info h3 {
      font-size: 21px;
      margin-bottom: 8px;
    }

    .product-info p {
      color: #aaa;
      margin-bottom: 15px;
      line-height: 1.5;
    }

    .price {
      color: #ffd84d;
      font-size: 23px;
      font-weight: bold;
      margin-bottom: 18px;
    }

    .order-btn {
      display: block;
      text-align: center;
      background: #ffd84d;
      color: #111;
      padding: 13px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    .order-btn:hover {
      background: white;
    }

    /* WHY US */
    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .feature {
      background: #1c1c1c;
      border: 1px solid #333;
      padding: 35px 25px;
      text-align: center;
      border-radius: 15px;
    }

    .feature .icon {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .feature h3 {
      margin-bottom: 10px;
    }

    .feature p {
      color: #aaa;
      line-height: 1.6;
    }

    /* CONTACT */
    .contact {
      background: #191919;
      text-align: center;
    }

    .contact p {
      color: #ccc;
      margin: 12px 0;
      font-size: 18px;
    }

    .whatsapp {
      display: inline-block;
      margin-top: 20px;
      background: #25D366;
      color: white;
      padding: 15px 30px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    /* FOOTER */
    footer {
      text-align: center;
      padding: 30px;
      background: #0b0b0b;
      color: #888;
    }

    /* MOBILE */
    @media (max-width: 800px) {

      header {
        padding: 18px 5%;
      }

      nav a {
        margin-left: 10px;
        font-size: 14px;
      }

      .hero h1 {
        font-size: 38px;
      }

      .products,
      .features {
        grid-template-columns: 1fr;
      }

      section {
        padding: 50px 5%;
      }
    }
  </style>
</head>

